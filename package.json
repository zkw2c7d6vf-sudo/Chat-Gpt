{
  "name": "orbit-personal-dashboard",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --use-env-proxy --env-file-if-exists=.env server/index.mjs\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs tests/*-unit.test.mjs",
    "test:e2e": "node tests/orbit.e2e.mjs",
    "format": "prettier --write src server tests scripts docs *.ts *.json *.md index.html",
    "test:v3": "node tests/v3.e2e.mjs",
    "test:v31": "node tests/v31.e2e.mjs",
    "test:v4": "node tests/v4.e2e.mjs",
    "test:v41": "node tests/v4.e2e.mjs",
    "test:home": "node tests/immersive-home.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
