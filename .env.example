# Use the exact origin at which you open Orbit. Register both callback URLs
# documented in README.md with the corresponding provider.
APP_URL=http://127.0.0.1:5173
PORT=3001
# Set 0.0.0.0 only when intentionally exposing the server behind a trusted proxy.
HOST=127.0.0.1

# Google Cloud OAuth web application (enable Calendar, Gmail, and Drive APIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify Developer Dashboard web application.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: enable the assistant's AI responses. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Private provider tokens; .orbit/ is excluded from Git. Keep it out of backups.
DASHBOARD_DATA_DIR=.orbit
